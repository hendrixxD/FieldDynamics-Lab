# Libraries the project chooses directly. Versions are pinned in requirements.txt, which is
# generated from this file: after editing, run bash .github/scripts/lock-requirements.sh

# Data acquisition
# earthaccess logs in to NASA Earthdata and opens SMAP granules remotely.
earthaccess
earthengine-api
geemap
requests

# Data processing and harmonization
# dask backs the lazy chunks= raster loading in docs/engineering-standards.md.
dask
geopandas
# h5py reads the Kaduna window out of SMAP HDF5 granules.
h5py
numpy
# openpyxl reads the KDBS retail price export (.xlsx).
openpyxl
pandas
pillow
# pyarrow is the Parquet engine for the feature tables.
pyarrow
rioxarray
shapely
xarray

# Science and modeling
lightgbm
optuna
# pandera validates processed data on load.
pandera
# rosetta-soil runs the USDA Rosetta3 neural-network pedotransfer function (A8 soil water).
rosetta-soil
# pymannkendall provides the Mann-Kendall test with Sen's slope for the GRACE-FO trend.
pymannkendall
salib
# scipy provides the Savitzky-Golay filter for NDVI smoothing.
scipy
scikit-learn
shap

# Notebooks
jupyter
matplotlib

# Backend
fastapi
jinja2
pydantic
# pydantic-settings and python-dotenv back the single Settings class that reads .env.
pydantic-settings
python-dotenv
# pyyaml reads the settings in config/.
pyyaml
uvicorn
