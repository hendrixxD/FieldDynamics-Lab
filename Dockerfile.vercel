# A container, because Vercel's Python runtime starts at 3.12 and this project pins 3.11.
FROM python:3.11.18-slim

WORKDIR /app

COPY requirements.txt requirements-serve.in ./
RUN pip install --no-cache-dir -c requirements.txt -r requirements-serve.in

COPY api ./api
COPY web ./web

# Vercel routes traffic to port 80.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "80"]
